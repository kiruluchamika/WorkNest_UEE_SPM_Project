{
  "name": "worknest-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:coverage": "npm run build && node --enable-source-maps --test --experimental-test-coverage --test-coverage-include=dist/controllers/*verif* --test-coverage-include=dist/validators/*verif* --test-coverage-include=dist/validators/auth.validator.js --test-coverage-include=dist/services/privateDocuments.js --test-coverage-include=../app/src/components/common/DocumentField.tsx --test-coverage-include=../app/src/utils/documentUpload.ts --test-coverage-include=../app/src/utils/validators.ts tests/*.test.cjs",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/assets','dist/assets',{recursive:true})\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "test:email": "ts-node --transpile-only src/scripts/testEmail.ts",
    "test:sample-email": "ts-node --transpile-only src/scripts/sendSampleEmail.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "^6.16.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "nodemon": "^3.1.14",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^6.16.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
