datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  jobseeker
  shopowner
  verifier
  admin
}

enum GigStatus {
  PENDING
  ACTIVE
  REJECTED
  CLOSED
  COMPLETED
}

enum PaymentType {
  HOURLY
  DAILY
  FIXED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(jobseeker)
  phone        String?
  bio          String?
  location     String?
  avatarUrl    String?
  trustScore   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  gigPosts     GigPost[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  gigPosts    GigPost[]
}

model GigPost {
  id              String      @id @default(uuid())
  title           String
  description     String
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  businessId      String
  business        User        @relation(fields: [businessId], references: [id])
  location        String
  paymentAmount   Decimal
  paymentType     PaymentType
  startDate       DateTime
  startTime       String?
  endDate         DateTime?
  endTime         String?
  workersNeeded   Int         @default(1)
  requiredSkills  String[]
  contactInfo     String?
  imageUrl        String?
  status          GigStatus   @default(PENDING)
  rejectionReason String?
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}
