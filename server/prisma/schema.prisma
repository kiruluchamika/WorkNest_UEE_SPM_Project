datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  jobseeker
  shopowner
  verifier
  admin
}

enum GigStatus {
  PENDING
  ACTIVE
  REJECTED
  CLOSED
  COMPLETED
}

enum PaymentType {
  HOURLY
  DAILY
  FIXED
}

enum ApplicationMode {
  QUICK_APPLY
  STANDARD
  PROFESSIONAL
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  HIRED
  REJECTED
  WITHDRAWN
  COMPLETED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(jobseeker)
  phone        String?
  bio          String?
  location     String?
  avatarUrl    String?
  trustScore   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  gigPosts     GigPost[]
  applications Application[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  gigPosts    GigPost[]
}

model GigPost {
  id              String      @id @default(uuid())
  title           String
  description     String
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  businessId      String
  business        User        @relation(fields: [businessId], references: [id])
  location        String
  paymentAmount   Decimal
  paymentType     PaymentType
  startDate       DateTime
  startTime       String?
  endDate         DateTime?
  endTime         String?
  workersNeeded   Int         @default(1)
  requiredSkills  String[]
  contactInfo     String?
  imageUrl        String?
  status          GigStatus   @default(PENDING)
  rejectionReason String?
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  applicationSettings ApplicationSettings?
  applications        Application[]
}

model ApplicationSettings {
  id                     String          @id @default(uuid())
  gigPostId              String          @unique
  gigPost                GigPost         @relation(fields: [gigPostId], references: [id])
  applicationMode        ApplicationMode @default(STANDARD)
  requireCV              Boolean         @default(false)
  requireCoverLetter     Boolean         @default(false)
  requireExperience      Boolean         @default(true)
  requireAvailability    Boolean         @default(true)
  requireTransportation  Boolean         @default(false)
  requirePortfolio       Boolean         @default(false)
  requireExpectedSalary  Boolean         @default(true)
  requireShortMessage    Boolean         @default(true)
  customQuestions        Json            @default("[]")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model Application {
  id               String            @id @default(uuid())
  gigPostId        String
  gigPost          GigPost           @relation(fields: [gigPostId], references: [id])
  applicantId      String
  applicant        User              @relation(fields: [applicantId], references: [id])
  applicationMode  ApplicationMode
  status           ApplicationStatus @default(PENDING)
  experience       String?
  availability     String?
  transportation   Boolean?
  shortMessage     String?
  cvUrl            String?
  coverLetter      String?
  portfolioUrl     String?
  expectedSalary   Decimal?
  answers          Json              @default("[]")
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([gigPostId, applicantId], name: "gigPostId_applicantId")
}
