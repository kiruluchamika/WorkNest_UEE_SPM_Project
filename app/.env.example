# Leave this unset for local dev — the app auto-detects the backend host
# (LAN IP / localhost) from however Expo was loaded. Only set it to point
# at a non-local backend (deployed/staging server).
# EXPO_PUBLIC_API_URL=http://<your-computer-lan-ip>:4000

# Required for device push notifications to register a token. One-time setup
# (whoever owns/creates the Expo account for this project runs this once):
#   1. npx eas-cli login
#   2. npx eas-cli init   (links/creates the EAS project for slug "worknest",
#                           prints a project ID)
# Paste that project ID below. Everyone on the team can then reuse it.
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
